# ============================================================
# CivicPulse AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env files containing real credentials.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=CivicPulse AI
APP_DEBUG=false

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- AI Provider (Google Gemini) ---
# Canonical LLM provider for CivicPulse AI is Google Gemini.
# Obtain API Key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Google OAuth (Authentication) ---
# Obtain these credentials from the Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- MongoDB ---
# Local Docker Compose default: mongodb://mongodb:27017/civicpulse
# For MongoDB Atlas set: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://mongodb:27017/civicpulse
MONGODB_DATABASE=civicpulse

# --- Redis ---
# Local Docker Compose default: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
